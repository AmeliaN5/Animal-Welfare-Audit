# 복사 후 .env.local 로 저장하고 값을 채우세요. (.env.local 은 Git에 올리지 마세요.)
# Vercel: add the same keys under Project → Settings → Environment Variables, then Redeploy.

# Supabase — 있으면 체크·메모·진행이 DB에 쌓입니다. 없으면 브라우저 로컬만 사용.
# 대시보드: Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Blob — 메모 첨부(사진·파일) 업로드에 사용. Vercel Storage에서 Blob 만들고 연결하면 토큰 자동 주입.
# 로컬 테스트: Vercel 대시보드에서 Read-write token 복사 후 여기에 붙여넣기
# BLOB_READ_WRITE_TOKEN=

# 선택: 보고서 메모 영어 번역에 Google Cloud Translation 사용 시
# GOOGLE_TRANSLATE_API_KEY=
